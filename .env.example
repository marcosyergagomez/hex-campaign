# Local development only. Copy to .env and keep .env out of git.
APP_ENV=development
DJANGO_SECRET_KEY=change-me-before-any-shared-environment
DATABASE_URL=postgres://hexcampaign:hexcampaign@localhost:5432/hexcampaign
# Local SMTP is Mailpit: port 1025, inbox at http://localhost:8025.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=noreply@localhost
# Origin used in the confirmation link. Required by config.settings.production.
API_ORIGIN=http://127.0.0.1:8000
PUBLIC_ORIGIN=http://localhost:5173
