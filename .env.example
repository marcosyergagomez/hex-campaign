# Local development only. Copy to .env and keep .env out of git.
APP_ENV=development
DJANGO_SECRET_KEY=change-me-before-any-shared-environment
# Host port 5433 is the Docker mapping. Postgres inside the container still listens on 5432.
DATABASE_URL=postgres://hexcampaign:hexcampaign@localhost:5433/hexcampaign
# Shared rate-limit cache. Empty = LocMem (one process). Several uvicorn
# workers need Redis: docker compose up -d redis and uncomment below.
# CACHE_URL=redis://127.0.0.1:6379/1
# Local SMTP is Mailpit: port 1025, inbox at http://localhost:8025.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=noreply@localhost
# Browser origin. Login refuses any other Origin, and confirmation links use it.
# Open the Vite app at http://localhost:5173. localhost and 127.0.0.1 are different
# origins. Production requires https.
API_ORIGIN=http://localhost:5173
# HMAC key for the player session cookie. Local only: production refuses this value.
SESSION_PEPPER=local-only-session-pepper-0123456789abcdef0123456789abcdef
# Set true only when a reverse proxy appends the client address and sets
# X-Forwarded-Proto. Leave false when uvicorn is reached directly.
TRUST_PROXY=false
PUBLIC_ORIGIN=http://localhost:5173
